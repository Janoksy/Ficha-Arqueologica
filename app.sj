var CHILE = {"Arica y Parinacota":{"Arica":["Arica","Camarones"],"Parinacota":["Putre","General Lagos"]},"Tarapacá":{"Tarapacá":["Iquique","Alto Hospicio"],"El Tamarugal":["Pozo Almonte","Camiña","Colchane","Huara","Pica"]},"Antofagasta":{"Antofagasta":["Antofagasta","Mejillones","Sierra Gorda","Taltal"],"El Loa":["Calama","Ollagüe","San Pedro de Atacama"],"Tocopilla":["Tocopilla","María Elena"]},"Atacama":{"Copiapó":["Copiapó","Caldera","Tierra Amarilla"],"Chañaral":["Chañaral","Diego de Almagro"],"Huasco":["Vallenar","Alto del Carmen","Freirina","Huasco"]},"Coquimbo":{"Elqui":["La Serena","Coquimbo","Andacollo","La Higuera","Paiguano","Vicuña"],"Choapa":["Illapel","Canela","Los Vilos","Salamanca"],"Limarí":["Ovalle","Combarbalá","Monte Patria","Punitaqui","Río Hurtado"]},"Valparaíso":{"Valparaíso":["Valparaíso","Casablanca","Concón","Juan Fernández","Puchuncaví","Quintero","Viña del Mar"],"Isla de Pascua":["Isla de Pascua"],"Los Andes":["Los Andes","Calle Larga","Rinconada","San Esteban"],"Petorca":["La Ligua","Cabildo","Papudo","Petorca","Zapallar"],"Quillota":["Quillota","Calera","Hijuelas","La Cruz","Nogales"],"San Antonio":["San Antonio","Algarrobo","Cartagena","El Quisco","El Tabo","Santo Domingo"],"San Felipe de Aconcagua":["San Felipe","Catemu","Llaillay","Panquehue","Putaendo","Santa María"],"Marga Marga":["Quilpué","Limache","Olmué","Villa Alemana"]},"Metropolitana":{"Santiago":["Santiago","Cerrillos","Cerro Navia","Conchalí","El Bosque","Estación Central","Huechuraba","Independencia","La Cisterna","La Florida","La Granja","La Pintana","La Reina","Las Condes","Lo Barnechea","Lo Espejo","Lo Prado","Macul","Maipú","Ñuñoa","Pedro Aguirre Cerda","Peñalolén","Providencia","Pudahuel","Quilicura","Quinta Normal","Recoleta","Renca","San Joaquín","San Miguel","San Ramón","Vitacura"],"Cordillera":["Puente Alto","Pirque","San José de Maipo"],"Chacabuco":["Colina","Lampa","Til Til"],"Maipo":["San Bernardo","Buin","Calera de Tango","Paine"],"Melipilla":["Melipilla","Alhué","Curacaví","María Pinto","San Pedro"],"Talagante":["Talagante","El Monte","Isla de Maipo","Padre Hurtado","Peñaflor"]},"O'Higgins":{"Cachapoal":["Rancagua","Codegua","Coinco","Coltauco","Doñihue","Graneros","Las Cabras","Machalí","Malloa","Mostazal","Olivar","Peumo","Pichidegua","Quinta de Tilcoco","Rengo","Requínoa","San Vicente"],"Cardenal Caro":["Pichilemu","La Estrella","Litueche","Marchigüe","Navidad","Paredones"],"Colchagua":["San Fernando","Chépica","Chimbarongo","Lolol","Nancagua","Palmilla","Peralillo","Placilla","Pumanque","Santa Cruz"]},"Maule":{"Talca":["Talca","Constitución","Curepto","Empedrado","Maule","Pelarco","Pencahue","Río Claro","San Clemente","San Rafael"],"Cauquenes":["Cauquenes","Chanco","Pelluhue"],"Curicó":["Curicó","Hualañé","Licantén","Molina","Rauco","Romeral","Sagrada Familia","Teno","Vichuquén"],"Linares":["Linares","Colbún","Longaví","Parral","Retiro","San Javier","Villa Alegre","Yerbas Buenas"]},"Ñuble":{"Diguillín":["Chillán","Bulnes","Chillán Viejo","El Carmen","Pemuco","Pinto","Quillón","San Ignacio","Yungay"],"Itata":["Quirihue","Cobquecura","Coelemu","Ninhue","Portezuelo","Ránquil","Treguaco"],"Punilla":["San Carlos","Coihueco","Ñiquén","San Fabián","San Nicolás"]},"Biobío":{"Concepción":["Concepción","Coronel","Chiguayante","Florida","Hualqui","Lota","Penco","San Pedro de la Paz","Santa Juana","Talcahuano","Tomé","Hualpén"],"Arauco":["Lebu","Arauco","Cañete","Contulmo","Curanilahue","Los Álamos","Tirúa"],"Biobío":["Los Ángeles","Antuco","Cabrero","Laja","Mulchén","Nacimiento","Negrete","Quilaco","Quilleco","San Rosendo","Santa Bárbara","Tucapel","Yumbel"]},"La Araucanía":{"Cautín":["Temuco","Carahue","Cunco","Curarrehue","Freire","Galvarino","Gorbea","Lautaro","Loncoche","Melipeuco","Nueva Imperial","Padre las Casas","Perquenco","Pitrufquén","Pucón","Saavedra","Teodoro Schmidt","Toltén","Vilcún","Villarrica","Cholchol"],"Malleco":["Angol","Collipulli","Curacautín","Ercilla","Lonquimay","Los Sauces","Lumaco","Purén","Renaico","Traiguén","Victoria"]},"Los Ríos":{"Valdivia":["Valdivia","Corral","Futrono","La Unión","Lago Ranco","Lanco","Los Lagos","Máfil","Mariquina","Paillaco","Panguipulli","Río Bueno"]},"Los Lagos":{"Llanquihue":["Puerto Montt","Calbuco","Cochamó","Fresia","Frutillar","Los Muermos","Llanquihue","Maullín","Puerto Varas"],"Chiloé":["Castro","Ancud","Chonchi","Curaco de Vélez","Dalcahue","Puqueldón","Queilén","Quellón","Quemchi","Quinchao"],"Osorno":["Osorno","Puerto Octay","Purranque","Puyehue","Río Negro","San Juan de la Costa","San Pablo"],"Palena":["Chaitén","Futaleufú","Hualaihué","Palena"]},"Aysén":{"Coyhaique":["Coyhaique","Lago Verde"],"Aysén":["Aysén","Cisnes","Guaitecas"],"Capitán Prat":["Cochrane","O'Higgins","Tortel"],"General Carrera":["Chile Chico","Río Ibáñez"]},"Magallanes":{"Magallanes":["Punta Arenas","Laguna Blanca","Río Verde","San Gregorio"],"Antártica Chilena":["Cabo de Hornos","Antártica"],"Tierra del Fuego":["Porvenir","Primavera","Timaukel"],"Última Esperanza":["Natales","Torres del Paine"]}};

var MATS=['Cerámica','Lítico','Osteofauna','Loza','Porcelana','Gres','Vidrio','Metal','Malacológico','Textil','Cuero'];
var fichas=[],currentId=null,photos=[],cfg={},vertices=[],estructuras=[];
var drawTool='pen',isDrawing=false,lastX=0,lastY=0,startX=0,startY=0,snapshot=null;
var isOnline=false,guardando=false,borradorTimer=null,detalleId=null;

function init(){
  try{fichas=JSON.parse(localStorage.getItem('fichas_ays')||'[]');}catch(e){fichas=[];}
  try{cfg=JSON.parse(localStorage.getItem('cfg_ays')||'{}');}catch(e){cfg={};}
  buildMats();loadCfg();populateRegiones();renderFichas();renderPhotos();setToday();initCanvas();initChkBtns();activarAutosave();
}

function updateSyncStatus(online){
  isOnline=online;
  var dot=document.getElementById('sync-dot'),banner=document.getElementById('sync-banner'),cfgSync=document.getElementById('cfg-sync');
  if(online){dot.className='sync-dot online';banner.className='sync-banner online';banner.textContent='🟢 Sincronizado en tiempo real';if(cfgSync)cfgSync.textContent='En línea ✅';}
  else{dot.className='sync-dot offline';banner.className='sync-banner offline';banner.textContent='🟡 Sin conexión — se sincronizará al reconectar';if(cfgSync)cfgSync.textContent='Sin conexión ⚠️';}
}

function pad(n){return String(n).padStart(2,'0');}
function setToday(){var d=new Date();document.getElementById('f-fecha').value=d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());}
function loadCfg(){if(cfg.proyecto)document.getElementById('cfg-proyecto').value=cfg.proyecto;if(cfg.resp)document.getElementById('cfg-resp').value=cfg.resp;if(cfg.campana)document.getElementById('cfg-campana').value=cfg.campana;}
function saveConfig(){cfg.proyecto=document.getElementById('cfg-proyecto').value;cfg.resp=document.getElementById('cfg-resp').value;cfg.campana=document.getElementById('cfg-campana').value;localStorage.setItem('cfg_ays',JSON.stringify(cfg));showToast('Configuración guardada');}

function initChkBtns(){
  document.querySelectorAll('.chk-btn').forEach(function(btn){
    btn.addEventListener('click',function(e){
      e.preventDefault();
      var isRadio=btn.getAttribute('data-radio')==='true',group=btn.getAttribute('data-group');
      if(isRadio){document.querySelectorAll('.chk-btn[data-group="'+group+'"]').forEach(function(b){b.classList.remove('on');});btn.classList.add('on');}
      else{btn.classList.toggle('on');}
    });
  });
}
function getChkValues(g){var v=[];document.querySelectorAll('.chk-btn[data-group="'+g+'"].on').forEach(function(b){v.push(b.getAttribute('data-value'));});return v;}
function getRadioValue(g){var b=document.querySelector('.chk-btn[data-group="'+g+'"].on');return b?b.getAttribute('data-value'):'';}
function setChkValues(g,vals){if(!vals)return;document.querySelectorAll('.chk-btn[data-group="'+g+'"]').forEach(function(b){b.classList.toggle('on',vals.indexOf(b.getAttribute('data-value'))>=0);});}
function setRadioValue(g,val){document.querySelectorAll('.chk-btn[data-group="'+g+'"]').forEach(function(b){b.classList.toggle('on',b.getAttribute('data-value')===val);});}
function clearAllChk(){document.querySelectorAll('.chk-btn').forEach(function(b){b.classList.remove('on');});}

function populateRegiones(){var s=document.getElementById('f-region'),f=document.getElementById('filter-region');Object.keys(CHILE).forEach(function(r){var o=document.createElement('option');o.value=r;o.textContent=r;s.appendChild(o);var o2=document.createElement('option');o2.value=r;o2.textContent=r;f.appendChild(o2);});}
function updateProvincias(){var r=document.getElementById('f-region').value,p=document.getElementById('f-provincia'),c=document.getElementById('f-comuna');p.innerHTML='<option value="">Seleccionar...</option>';c.innerHTML='<option value="">Seleccionar...</option>';if(!r||!CHILE[r])return;Object.keys(CHILE[r]).forEach(function(pv){var o=document.createElement('option');o.value=pv;o.textContent=pv;p.appendChild(o);});}
function updateComunas(){var r=document.getElementById('f-region').value,p=document.getElementById('f-provincia').value,c=document.getElementById('f-comuna');c.innerHTML='<option value="">Seleccionar...</option>';if(!r||!p||!CHILE[r]||!CHILE[r][p])return;CHILE[r][p].forEach(function(cm){var o=document.createElement('option');o.value=cm;o.textContent=cm;c.appendChild(o);});}
function setRegion(r,p,c){document.getElementById('f-region').value=r||'';updateProvincias();if(p){document.getElementById('f-provincia').value=p;updateComunas();}if(c)document.getElementById('f-comuna').value=c;}

function tiempoRelativo(ts){
  if(!ts)return'';
  var diff=Math.floor((Date.now()-new Date(ts).getTime())/1000);
  if(diff<60)return'hace '+diff+'s';
  if(diff<3600)return'hace '+Math.floor(diff/60)+'min';
  if(diff<86400)return'hace '+Math.floor(diff/3600)+'h';
  if(diff<604800)return'hace '+Math.floor(diff/86400)+'d';
  return new Date(ts).toLocaleDateString('es-CL',{day:'numeric',month:'short'});
}

function showScreen(name){
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
  document.querySelectorAll('nav button').forEach(function(b){b.classList.remove('active');});
  document.getElementById('screen-'+name).classList.add('active');
  var navBtn=document.getElementById('nav-'+name);if(navBtn)navBtn.classList.add('active');
  if(name==='home')renderFichas();
  if(name==='config')document.getElementById('cfg-count').textContent=fichas.length+' fichas';
  if(name==='form'&&!currentId)restaurarBorrador();
}

function guardarBorrador(){try{localStorage.setItem('borrador_ays',JSON.stringify(getForm()));}catch(e){}}
function restaurarBorrador(){
  try{
    var raw=localStorage.getItem('borrador_ays');if(!raw)return;
    var d=JSON.parse(raw);if(!d||(!d.sitio&&!d.proyecto&&!d.responsable))return;
    var banner=document.createElement('div');banner.id='borrador-banner';
    banner.style.cssText='background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:13px;color:#856404;display:flex;justify-content:space-between;align-items:center;gap:10px;';
    banner.innerHTML='<span>📝 Tienes un borrador guardado</span><div style="display:flex;gap:8px"><button onclick="cargarBorrador()" style="background:#3a7d2c;color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer">Restaurar</button><button onclick="descartarBorrador()" style="background:none;border:1px solid #ccc;border-radius:6px;padding:6px 10px;font-size:12px;cursor:pointer">Descartar</button></div>';
    var form=document.getElementById('screen-form'),fc=form.querySelector('.sec');if(fc)form.insertBefore(banner,fc);
  }catch(e){}
}
function cargarBorrador(){
  try{var d=JSON.parse(localStorage.getItem('borrador_ays'));if(!d)return;buildMats();setForm(d);document.getElementById('ficha-id-badge').textContent=d.codigo||'';var b=document.getElementById('borrador-banner');if(b)b.remove();showToast('📝 Borrador restaurado','success');}catch(e){}
}
function descartarBorrador(){localStorage.removeItem('borrador_ays');var b=document.getElementById('borrador-banner');if(b)b.remove();}
function activarAutosave(){
  document.querySelectorAll('#screen-form input,#screen-form textarea,#screen-form select').forEach(function(el){
    el.addEventListener('input',function(){clearTimeout(borradorTimer);borradorTimer=setTimeout(guardarBorrador,1500);});
    el.addEventListener('change',function(){clearTimeout(borradorTimer);borradorTimer=setTimeout(guardarBorrador,1500);});
  });
}

function nuevaFicha(){
  currentId=null;photos=[];vertices=[];estructuras=[];guardando=false;
  document.querySelectorAll('#screen-form input:not([type=file]):not([type=hidden])').forEach(function(el){el.value='';});
  document.querySelectorAll('#screen-form textarea').forEach(function(el){el.value='';});
  document.querySelectorAll('#screen-form select').forEach(function(el){el.selectedIndex=0;});
  updateProvincias();updateComunas();clearAllChk();buildMats();renderPhotos();renderVertices();renderEstructuras();setToday();clearCanvas();
  if(cfg.proyecto)document.getElementById('f-proyecto').value=cfg.proyecto;
  if(cfg.resp)document.getElementById('f-responsable').value=cfg.resp;
  if(cfg.campana)document.getElementById('f-campana').value=cfg.campana;
  document.getElementById('gps-coords').textContent='Sin coordenadas aún';
  document.getElementById('gps-status').textContent='';
  document.getElementById('f-lat').value='';document.getElementById('f-lon').value='';
  document.getElementById('btn-pdf').style.display='none';document.getElementById('btn-del').style.display='none';
  document.getElementById('form-title').textContent='Nueva Ficha';document.getElementById('ficha-id-badge').textContent='';
  var btn=document.getElementById('btn-guardar');btn.disabled=false;btn.className='btn btn-save';
  document.getElementById('btn-guardar-txt').textContent='Guardar Ficha';
  showScreen('form');
}

function editarDesdeDetalle(){if(!detalleId)return;loadFicha(detalleId);}

function addVertice(){vertices.push({ubicacion:'Dentro del AI',n:'',e:''});renderVertices();}
function removeVertice(i){vertices.splice(i,1);renderVertices();}
function renderVertices(){
  var html='';vertices.forEach(function(v,i){html+='<div class="vtx-row"><span>'+(i+1)+'</span><input type="text" value="'+v.ubicacion+'" onchange="vertices['+i+'].ubicacion=this.value" placeholder="Ubicación"><input type="text" value="'+v.n+'" onchange="vertices['+i+'].n=this.value" placeholder="Norte"><input type="text" value="'+v.e+'" onchange="vertices['+i+'].e=this.value" placeholder="Este"><button onclick="removeVertice('+i+')">✕</button></div>';});
  document.getElementById('vtx-list').innerHTML=html;
}

function addEstructura(){estructuras.push({nombre:'',largo:'',ancho:'',alto:'',forma:'',materialidad:'',hileras:'',hiladas:'',vanos:'',obs:''});renderEstructuras();}
function removeEstructura(i){estructuras.splice(i,1);renderEstructuras();}
function renderEstructuras(){
  var html='';
  estructuras.forEach(function(e,i){
    html+='<div class="est-row"><div class="est-row-header"><span>🧱 Estructura '+(i+1)+'</span><button class="btn btn-danger btn-sm" onclick="removeEstructura('+i+')">✕</button></div>';
    html+='<div class="field"><label>Nombre / ID</label><input type="text" value="'+(e.nombre||'')+'" onchange="estructuras['+i+'].nombre=this.value" placeholder="Ej: E1..."></div>';
    html+='<div class="row3"><div class="field"><label>Largo (m)</label><input type="number" step="any" value="'+(e.largo||'')+'" onchange="estructuras['+i+'].largo=this.value"></div><div class="field"><label>Ancho (m)</label><input type="number" step="any" value="'+(e.ancho||'')+'" onchange="estructuras['+i+'].ancho=this.value"></div><div class="field"><label>Alto (m)</label><input type="number" step="any" value="'+(e.alto||'')+'" onchange="estructuras['+i+'].alto=this.value"></div></div>';
    html+='<div class="row2"><div class="field"><label>Forma</label><select onchange="estructuras['+i+'].forma=this.value"><option value="">...</option><option'+(e.forma==='Rectangular'?' selected':'')+'>Rectangular</option><option'+(e.forma==='Circular'?' selected':'')+'>Circular</option><option'+(e.forma==='Semicircular'?' selected':'')+'>Semicircular</option><option'+(e.forma==='Irregular'?' selected':'')+'>Irregular</option><option'+(e.forma==='Cuadrangular'?' selected':'')+'>Cuadrangular</option><option'+(e.forma==='Otra'?' selected':'')+'>Otra</option></select></div><div class="field"><label>Materialidad</label><select onchange="estructuras['+i+'].materialidad=this.value"><option value="">...</option><option'+(e.materialidad==='Piedra seca'?' selected':'')+'>Piedra seca</option><option'+(e.materialidad==='Piedra con barro'?' selected':'')+'>Piedra con barro</option><option'+(e.materialidad==='Adobe'?' selected':'')+'>Adobe</option><option'+(e.materialidad==='Tapia'?' selected':'')+'>Tapia</option><option'+(e.materialidad==='Mixta'?' selected':'')+'>Mixta</option><option'+(e.materialidad==='Otra'?' selected':'')+'>Otra</option></select></div></div>';
    html+='<div class="row3"><div class="field"><label>Hileras</label><input type="number" min="0" value="'+(e.hileras||'')+'" onchange="estructuras['+i+'].hileras=this.value"></div><div class="field"><label>Hiladas</label><input type="number" min="0" value="'+(e.hiladas||'')+'" onchange="estructuras['+i+'].hiladas=this.value"></div><div class="field"><label>Vanos</label><input type="number" min="0" value="'+(e.vanos||'')+'" onchange="estructuras['+i+'].vanos=this.value"></div></div>';
    html+='<div class="field"><label>Observaciones</label><textarea onchange="estructuras['+i+'].obs=this.value">'+(e.obs||'')+'</textarea></div></div>';
  });
  document.getElementById('estructuras-list').innerHTML=html;
}

function buildMats(){var h='';MATS.forEach(function(m){h+='<tr><td><b>'+m+'</b></td><td><input type="number" min="0" id="mq-'+m+'" placeholder="0" style="width:60px"></td><td><input type="text" id="md-'+m+'" placeholder="Descripción..."></td></tr>';});document.getElementById('mat-body').innerHTML=h;}

function getGPS(){
  var status=document.getElementById('gps-status'),coords=document.getElementById('gps-coords'),btn=document.getElementById('btn-gps');
  if(!navigator.geolocation){status.textContent='GPS no disponible';return;}
  var bestAcc=Infinity,watchId=null,attempts=0,timeout=null;
  btn.disabled=true;btn.textContent='🔄 Buscando...';status.textContent='Capturando lecturas...';
  function done(){if(watchId!==null)navigator.geolocation.clearWatch(watchId);clearTimeout(timeout);btn.disabled=false;btn.textContent='📡 Actualizar GPS';}
  watchId=navigator.geolocation.watchPosition(function(pos){
    var lat=pos.coords.latitude,lon=pos.coords.longitude,acc=pos.coords.accuracy,alt=pos.coords.altitude;
    attempts++;status.textContent='Lectura '+attempts+'/8 — ±'+Math.round(acc)+' m';
    if(acc<bestAcc){bestAcc=acc;document.getElementById('f-lat').value=lat.toFixed(6);document.getElementById('f-lon').value=lon.toFixed(6);if(alt)document.getElementById('f-altitud').value=Math.round(alt);document.getElementById('f-error').value=Math.round(acc);var utm=toUTM(lat,lon);document.getElementById('f-utmn').value=Math.round(utm.N);document.getElementById('f-utme').value=Math.round(utm.E);document.getElementById('f-huso').value=utm.zone;coords.textContent='UTM N: '+Math.round(utm.N)+'  E: '+Math.round(utm.E)+'  Huso: '+utm.zone;}
    if(acc<=5||attempts>=8){done();status.textContent='✅ Precisión: ±'+Math.round(bestAcc)+' m';}
  },function(err){done();status.textContent='❌ '+err.message;},{enableHighAccuracy:true,timeout:20000,maximumAge:0});
  timeout=setTimeout(function(){done();status.textContent=bestAcc<Infinity?'✅ Mejor: ±'+Math.round(bestAcc)+' m':'⏱ Sin señal.';},25000);
}

function toUTM(lat,lon){
  var a=6378137,f=1/298.257223563,b=a*(1-f),e2=1-(b*b)/(a*a);
  var zone=Math.floor((lon+180)/6)+1,lon0=(zone-1)*6-180+3;
  var k0=0.9996,N0=lat>=0?0:10000000,E0=500000;
  var phi=lat*Math.PI/180,lam=(lon-lon0)*Math.PI/180;
  var N=a/Math.sqrt(1-e2*Math.sin(phi)*Math.sin(phi));
  var T=Math.tan(phi)*Math.tan(phi),C=e2/(1-e2)*Math.cos(phi)*Math.cos(phi),A=Math.cos(phi)*lam;
  var M=a*((1-e2/4-3*e2*e2/64)*phi-(3*e2/8+3*e2*e2/32)*Math.sin(2*phi)+(15*e2*e2/256)*Math.sin(4*phi));
  var E=k0*N*(A+(1-T+C)*A*A*A/6+(5-18*T+T*T+72*C)*A*A*A*A*A/120)+E0;
  var Nn=k0*(M+N*Math.tan(phi)*(A*A/2+(5-T+9*C+4*C*C)*A*A*A*A/24+(61-58*T+T*T+600*C)*A*A*A*A*A*A/720))+N0;
  return{E:E,N:Nn,zone:zone+(lat>=0?'':'S')};
}
function calcArea(){var l=parseFloat(document.getElementById('f-largo').value)||0,a=parseFloat(document.getElementById('f-ancho').value)||0;if(l&&a)document.getElementById('f-area').value=(l*a).toFixed(2);}

function initCanvas(){
  var canvas=document.getElementById('croquis-canvas'),ctx=canvas.getContext('2d');
  ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);
  function getPos(e){var r=canvas.getBoundingClientRect(),sx=canvas.width/r.width,sy=canvas.height/r.height,src=e.touches?e.touches[0]:e;return{x:(src.clientX-r.left)*sx,y:(src.clientY-r.top)*sy};}
  function start(e){e.preventDefault();isDrawing=true;var p=getPos(e);lastX=p.x;lastY=p.y;startX=p.x;startY=p.y;if(drawTool==='line')snapshot=ctx.getImageData(0,0,canvas.width,canvas.height);}
  function move(e){e.preventDefault();if(!isDrawing)return;var p=getPos(e),color=document.getElementById('draw-color').value,size=parseInt(document.getElementById('draw-size').value);ctx.lineJoin='round';ctx.lineCap='round';if(drawTool==='pen'){ctx.strokeStyle=color;ctx.lineWidth=size;ctx.beginPath();ctx.moveTo(lastX,lastY);ctx.lineTo(p.x,p.y);ctx.stroke();}else if(drawTool==='eraser'){ctx.strokeStyle='#fff';ctx.lineWidth=size*4;ctx.beginPath();ctx.moveTo(lastX,lastY);ctx.lineTo(p.x,p.y);ctx.stroke();}else if(drawTool==='line'){ctx.putImageData(snapshot,0,0);ctx.strokeStyle=color;ctx.lineWidth=size;ctx.beginPath();ctx.moveTo(startX,startY);ctx.lineTo(p.x,p.y);ctx.stroke();}lastX=p.x;lastY=p.y;}
  function end(e){e.preventDefault();isDrawing=false;}
  canvas.addEventListener('mousedown',start);canvas.addEventListener('mousemove',move);canvas.addEventListener('mouseup',end);
  canvas.addEventListener('touchstart',start,{passive:false});canvas.addEventListener('touchmove',move,{passive:false});canvas.addEventListener('touchend',end,{passive:false});
}
function setTool(t){drawTool=t;['pen','line','eraser'].forEach(function(tt){document.getElementById('tool-'+tt).classList.toggle('active',tt===t);});}
function clearCanvas(){var c=document.getElementById('croquis-canvas'),ctx=c.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);}
function getCanvasData(){return document.getElementById('croquis-canvas').toDataURL('image/png');}
function loadCanvasData(data){if(!data)return;var c=document.getElementById('croquis-canvas'),ctx=c.getContext('2d'),img=new Image();img.onload=function(){ctx.drawImage(img,0,0);};img.src=data;}

function addPhoto(e){Array.from(e.target.files).forEach(function(f){var r=new FileReader();r.onload=function(ev){photos.push(ev.target.result);renderPhotos();};r.readAsDataURL(f);});e.target.value='';}
function renderPhotos(){var h=photos.map(function(p,i){return '<div class="photo-thumb"><img src="'+p+'"><button class="del-photo" onclick="removePhoto('+i+')">×</button></div>';}).join('');h+='<label class="add-photo-btn" for="photo-input"><span style="font-size:28px">📷</span><span>Agregar</span></label>';document.getElementById('photos-grid').innerHTML=h;}
function removePhoto(i){photos.splice(i,1);renderPhotos();}

function nextId(){var max=0;fichas.forEach(function(f){if(f.codigo){var n=parseInt(f.codigo.replace('RS-',''));if(n>max)max=n;}});return'RS-'+String(max+1).padStart(3,'0');}

function getForm(){
  var mats={};MATS.forEach(function(m){var q=document.getElementById('mq-'+m),d=document.getElementById('md-'+m);mats[m]={qty:q?q.value:'',desc:d?d.value:''};});
  return{id:currentId||String(Date.now()),codigo:document.getElementById('ficha-id-badge').textContent||nextId(),sitio:document.getElementById('f-sitio').value,proyecto:document.getElementById('f-proyecto').value,region:document.getElementById('f-region').value,provincia:document.getElementById('f-provincia').value,comuna:document.getElementById('f-comuna').value,lat:document.getElementById('f-lat').value,lon:document.getElementById('f-lon').value,utmN:document.getElementById('f-utmn').value,utmE:document.getElementById('f-utme').value,huso:document.getElementById('f-huso').value,error:document.getElementById('f-error').value,altitud:document.getElementById('f-altitud').value,vertices:vertices,tipo:document.getElementById('f-tipo').value,tipologia:getChkValues('tipologia'),tipologiaOtro:document.getElementById('f-tipologia-otro').value,periodo:getChkValues('periodo'),periodoEsp:document.getElementById('f-periodo-esp').value,recoleccion:getRadioValue('recoleccion'),largo:document.getElementById('f-largo').value,ancho:document.getElementById('f-ancho').value,area:document.getElementById('f-area').value,mats:mats,diagnosticos:document.getElementById('f-diagnosticos').value,estructuras:estructuras,emplazamiento:getChkValues('emplazamiento'),emplOtro:document.getElementById('f-empl-otro').value,emplDesc:document.getElementById('f-empl-desc').value,conservacion:getRadioValue('conservacion'),consDesc:document.getElementById('f-cons-desc').value,responsable:document.getElementById('f-responsable').value,ayudantes:document.getElementById('f-ayudantes').value,fecha:document.getElementById('f-fecha').value,campana:document.getElementById('f-campana').value,obs:document.getElementById('f-obs').value,croquis:getCanvasData(),photos:photos,ts:new Date().toISOString()};
}

function setForm(d){
  document.getElementById('f-sitio').value=d.sitio||'';document.getElementById('f-proyecto').value=d.proyecto||'';
  setRegion(d.region,d.provincia,d.comuna);
  document.getElementById('f-lat').value=d.lat||'';document.getElementById('f-lon').value=d.lon||'';
  document.getElementById('f-utmn').value=d.utmN||'';document.getElementById('f-utme').value=d.utmE||'';document.getElementById('f-huso').value=d.huso||'';
  document.getElementById('f-error').value=d.error||'';document.getElementById('f-altitud').value=d.altitud||'';
  vertices=d.vertices||[];renderVertices();
  document.getElementById('f-tipo').value=d.tipo||'';
  setChkValues('tipologia',d.tipologia);document.getElementById('f-tipologia-otro').value=d.tipologiaOtro||'';
  setChkValues('periodo',d.periodo);document.getElementById('f-periodo-esp').value=d.periodoEsp||'';
  setRadioValue('recoleccion',d.recoleccion);
  document.getElementById('f-largo').value=d.largo||'';document.getElementById('f-ancho').value=d.ancho||'';document.getElementById('f-area').value=d.area||'';
  MATS.forEach(function(m){var md=d.mats&&d.mats[m]?d.mats[m]:{qty:'',desc:''};var q=document.getElementById('mq-'+m),dd=document.getElementById('md-'+m);if(q)q.value=md.qty||'';if(dd)dd.value=md.desc||'';});
  document.getElementById('f-diagnosticos').value=d.diagnosticos||'';
  estructuras=d.estructuras||[];renderEstructuras();
  setChkValues('emplazamiento',d.emplazamiento);document.getElementById('f-empl-otro').value=d.emplOtro||'';document.getElementById('f-empl-desc').value=d.emplDesc||'';
  setRadioValue('conservacion',d.conservacion);document.getElementById('f-cons-desc').value=d.consDesc||'';
  document.getElementById('f-responsable').value=d.responsable||'';document.getElementById('f-ayudantes').value=d.ayudantes||'';
  document.getElementById('f-fecha').value=d.fecha||'';document.getElementById('f-campana').value=d.campana||'';
  document.getElementById('f-obs').value=d.obs||'';
  photos=d.photos||[];renderPhotos();
  clearCanvas();if(d.croquis)setTimeout(function(){loadCanvasData(d.croquis);},100);
  if(d.lat&&d.lon)document.getElementById('gps-coords').textContent='UTM N: '+d.utmN+'  E: '+d.utmE+'  Huso: '+d.huso;
}

async function saveFicha(){
  if(guardando)return;
  var data=getForm();
  if(!data.sitio){showToast('⚠️ Ingresa el nombre del sitio','error');return;}
  if(!data.codigo)data.codigo=nextId();
  guardando=true;
  var btn=document.getElementById('btn-guardar'),btnTxt=document.getElementById('btn-guardar-txt');
  btn.disabled=true;btn.classList.add('saving');btnTxt.textContent='Guardando...';
  var idx=-1;fichas.forEach(function(f,i){if(f.id===data.id)idx=i;});
  if(idx>=0)fichas[idx]=data;else fichas.unshift(data);
  localStorage.setItem('fichas_ays',JSON.stringify(fichas));
  localStorage.removeItem('borrador_ays');
  var syncOk=false;if(window._fbSave)syncOk=await window._fbSave(data);
  btn.classList.remove('saving');btn.classList.add('saved');
  if(syncOk){btnTxt.textContent='✅ '+data.codigo+' guardada';showToast('✅ '+data.codigo+' guardada y sincronizada ☁️','success');}
  else{btnTxt.textContent='💾 '+data.codigo+' guardada';showToast('💾 '+data.codigo+' guardada localmente');}
  currentId=data.id;
  document.getElementById('btn-pdf').style.display='inline-flex';document.getElementById('btn-del').style.display='inline-flex';
  document.getElementById('form-title').textContent='Editando: '+data.sitio;document.getElementById('ficha-id-badge').textContent=data.codigo;
  setTimeout(function(){guardando=false;btn.disabled=false;btn.className='btn btn-save';btnTxt.textContent='💾 Guardar Ficha';},2000);
}

function loadFicha(id){
  var d=null;fichas.forEach(function(f){if(f.id===id)d=f;});if(!d)return;
  currentId=id;buildMats();setForm(d);
  document.getElementById('btn-pdf').style.display='inline-flex';document.getElementById('btn-del').style.display='inline-flex';
  document.getElementById('form-title').textContent='Editando: '+d.sitio;document.getElementById('ficha-id-badge').textContent=d.codigo||'';
  guardando=false;showScreen('form');
}

function verDetalle(id){
  var f=null;fichas.forEach(function(x){if(x.id===id)f=x;});if(!f)return;
  detalleId=id;
  var totalMat=(f.mats?Object.values(f.mats).reduce(function(s,m){return s+(parseInt(m.qty)||0);},0):0);
  var heroHtml='<div class="detail-hero">';
  if(f.photos&&f.photos.length){heroHtml+='<img src="'+f.photos[0]+'">';}
  heroHtml+='<div class="detail-hero-overlay"><div class="detail-hero-id">'+(f.codigo||'')+'</div><div class="detail-hero-title">'+(f.sitio||'Sin nombre')+'</div><div class="detail-hero-sub">'+(f.proyecto||'')+(f.region?' · '+f.region:'')+'</div></div></div>';
  var html=heroHtml;
  html+='<div class="detail-section"><div class="detail-sec-title">📋 Identificación</div>';
  html+='<div class="detail-row"><span class="detail-key">Responsable</span><span class="detail-val">'+(f.responsable||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Fecha</span><span class="detail-val">'+(f.fecha||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Campaña</span><span class="detail-val">'+(f.campana||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Ayudantes</span><span class="detail-val">'+(f.ayudantes||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Región</span><span class="detail-val">'+(f.region||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Provincia/Comuna</span><span class="detail-val">'+(f.provincia||'—')+(f.comuna?', '+f.comuna:'')+'</span></div></div>';
  if(f.utmN||f.utmE){
    html+='<div class="detail-section"><div class="detail-sec-title">📍 Coordenadas WGS84</div>';
    html+='<div class="detail-row"><span class="detail-key">UTM Norte</span><span class="detail-val">'+(f.utmN||'—')+'</span></div>';
    html+='<div class="detail-row"><span class="detail-key">UTM Este</span><span class="detail-val">'+(f.utmE||'—')+'</span></div>';
    html+='<div class="detail-row"><span class="detail-key">Huso</span><span class="detail-val">'+(f.huso||'—')+'</span></div>';
    html+='<div class="detail-row"><span class="detail-key">Altitud</span><span class="detail-val">'+(f.altitud?f.altitud+' msnm':'—')+'</span></div>';
    html+='<div class="detail-row"><span class="detail-key">Error GPS</span><span class="detail-val">'+(f.error?'±'+f.error+' m':'—')+'</span></div></div>';
  }
  html+='<div class="detail-section"><div class="detail-sec-title">🏛 Características</div>';
  html+='<div class="detail-row"><span class="detail-key">Tipo</span><span class="detail-val">'+(f.tipo||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Tipología</span><span class="detail-val">'+((f.tipologia||[]).join(', ')||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Período</span><span class="detail-val">'+((f.periodo||[]).join(', ')||'—')+(f.periodoEsp?' ('+f.periodoEsp+')':'')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Emplazamiento</span><span class="detail-val">'+((f.emplazamiento||[]).join(', ')||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Conservación</span><span class="detail-val">'+(f.conservacion||'—')+'</span></div>';
  html+='<div class="detail-row"><span class="detail-key">Dimensiones</span><span class="detail-val">'+(f.largo?f.largo+'m × '+f.ancho+'m = '+f.area+'m²':'—')+'</span></div></div>';
  if(totalMat>0){
    html+='<div class="detail-section"><div class="detail-sec-title">🪨 Material ('+totalMat+' piezas)</div>';
    MATS.forEach(function(m){var md=f.mats&&f.mats[m];if(md&&md.qty&&parseInt(md.qty)>0){html+='<div class="detail-row"><span class="detail-key">'+m+'</span><span class="detail-val">'+md.qty+(md.desc?' — '+md.desc:'')+'</span></div>';}});
    html+='</div>';
  }
  if(f.photos&&f.photos.length>0){
    html+='<div class="detail-section"><div class="detail-sec-title">📸 Fotografías ('+f.photos.length+')</div><div class="detail-photos">';
    f.photos.forEach(function(p){html+='<div class="detail-photo"><img src="'+p+'"></div>';});
    html+='</div></div>';
  }
  if(f.obs){html+='<div class="detail-section"><div class="detail-sec-title">📝 Observaciones</div><div style="padding:12px 14px;font-size:13px;line-height:1.6;color:var(--text)">'+f.obs+'</div></div>';}
  document.getElementById('detalle-content').innerHTML=html;
  var acciones='<button class="btn btn-primary" onclick="compartirWhatsApp(\''+id+'\')">📲 Compartir WhatsApp</button>';
  acciones+='<button class="btn btn-outline" onclick="loadFicha(\''+id+'\');exportPDF()">📄 Exportar PDF</button>';
  acciones+='<button class="btn btn-danger btn-sm" onclick="detalleId=\''+id+'\';currentId=\''+id+'\';askDelete()">🗑 Eliminar</button>';
  document.getElementById('detalle-actions').innerHTML=acciones;
  showScreen('detalle');
}

function compartirWhatsApp(id){
  var f=null;fichas.forEach(function(x){if(x.id===id)f=x;});if(!f)return;
  var totalMat=(f.mats?Object.values(f.mats).reduce(function(s,m){return s+(parseInt(m.qty)||0);},0):0);
  var msg='🏛 *Ficha Arqueológica '+(f.codigo||'')+'*\n\n';
  msg+='📍 *Sitio:* '+(f.sitio||'—')+'\n';
  msg+='📁 *Proyecto:* '+(f.proyecto||'—')+'\n';
  msg+='🗓 *Fecha:* '+(f.fecha||'—')+'\n';
  msg+='👤 *Responsable:* '+(f.responsable||'—')+'\n';
  msg+='🌍 *Ubicación:* '+(f.region||'—')+(f.comuna?', '+f.comuna:'')+'\n';
  if(f.utmN)msg+='📡 *UTM:* N '+f.utmN+' E '+f.utmE+' H'+f.huso+'\n';
  if(f.tipo)msg+='🏛 *Tipo:* '+f.tipo+'\n';
  if(f.conservacion)msg+='📊 *Conservación:* '+f.conservacion+'\n';
  if(totalMat)msg+='🪨 *Material:* '+totalMat+' piezas\n';
  msg+='\n_Enviado desde ArqField — Ambiental y Sectorial_';
  window.open('https://wa.me/?text='+encodeURIComponent(msg),'_blank');
}

function askDelete(){document.getElementById('modal-del').classList.add('open');}
function closeModal(id){document.getElementById(id).classList.remove('open');}
async function confirmDelete(){
  if(window._fbDelete)await window._fbDelete(currentId);
  fichas=fichas.filter(function(f){return f.id!==currentId;});
  localStorage.setItem('fichas_ays',JSON.stringify(fichas));
  closeModal('modal-del');showScreen('home');showToast('🗑 Ficha eliminada');
}

function renderFichas(){
  var list=document.getElementById('fichas-list');
  var q=(document.getElementById('search-input').value||'').toLowerCase();
  var r=document.getElementById('filter-region').value;
  var filtered=fichas.filter(function(f){
    var match=!q||(f.sitio&&f.sitio.toLowerCase().includes(q))||(f.proyecto&&f.proyecto.toLowerCase().includes(q))||(f.fecha&&f.fecha.includes(q))||(f.codigo&&f.codigo.toLowerCase().includes(q));
    return match&&(!r||f.region===r);
  });
  var totalMat=fichas.reduce(function(s,f){return s+(f.mats?Object.values(f.mats).reduce(function(ss,m){return ss+(parseInt(m.qty)||0);},0):0);},0);
  var conGps=fichas.filter(function(f){return f.lat;}).length;
  document.getElementById('stats-row').innerHTML=
    '<div class="stat-card"><div class="stat-num">'+fichas.length+'</div><div class="stat-label">Fichas</div></div>'+
    '<div class="stat-card"><div class="stat-num">'+totalMat+'</div><div class="stat-label">Piezas</div></div>'+
    '<div class="stat-card"><div class="stat-num">'+conGps+'</div><div class="stat-label">Con GPS</div></div>';
  if(!fichas.length){list.innerHTML='<div class="empty"><div class="icon">🏛</div><p>No hay fichas guardadas.<br>Toca <b>Nueva</b> para comenzar.</p></div>';return;}
  if(!filtered.length){list.innerHTML='<div class="empty"><div class="icon">🔍</div><p>No hay fichas que coincidan.</p></div>';return;}
  var grupos={};
  filtered.forEach(function(f){var k=f.proyecto||'Sin proyecto';if(!grupos[k])grupos[k]=[];grupos[k].push(f);});
  var html='';
  Object.keys(grupos).forEach(function(proy){
    html+='<div class="proyecto-group-title">📁 '+proy+' <span style="color:#aaa;font-weight:400">('+grupos[proy].length+')</span></div>';
    grupos[proy].forEach(function(f){
      var coverHtml=f.photos&&f.photos.length?'<img class="ficha-card-cover" src="'+f.photos[0]+'" loading="lazy">':'<div class="ficha-card-cover-placeholder"></div>';
      var b='';
      if(f.codigo)b+='<span class="badge">'+f.codigo+'</span>';
      if(f.lat)b+='<span class="badge">🌐 GPS</span>';
      if(f.photos&&f.photos.length)b+='<span class="badge">📷 '+f.photos.length+'</span>';
      if(f.estructuras&&f.estructuras.length)b+='<span class="badge">🧱 '+f.estructuras.length+'</span>';
      html+='<div class="ficha-card" onclick="verDetalle(\''+f.id+'\')">';
      html+=coverHtml;
      html+='<div class="ficha-card-body">';
      html+='<div class="ficha-card-top"><div class="ficha-card-sitio">'+(f.sitio||'Sin nombre')+'</div><div class="ficha-card-tiempo">'+tiempoRelativo(f.ts)+'</div></div>';
      html+='<div class="ficha-card-proyecto">'+(f.responsable||'—')+(f.region?' · '+f.region:'')+'</div>';
      html+='<div class="badges">'+b+'</div></div></div>';
    });
  });
  list.innerHTML=html;
}

function exportExcel(){
  if(!fichas.length){showToast('No hay fichas para exportar');return;}
  var headers=['ID Proyecto','Proyecto','ID','WGS84 UTM N','UTM E','HUSO','Error GPS +-','ALTITUD','REGIÓN','PROVINCIA','COMUNA','Categoria Patrimonial','Tipo','N° objetos hallazgo aislado','Tipología funcional','Otro','Cronología','Cronología específica','Cerámica','Lítico','Malacológico','Osteofauna','Metal','Vidrio','Porcelana','Loza','Otros','Descripción Otros','Descripción de evidencias muebles en el sitio o hallazgo aislado','Estructura demarcatoria','Estructura habitacional','Estructura productiva','Estructura indeterminada','Conchal','Arte rupestre','Rasgo lineal','Rasgo estructural','Otro','Descripción Otros','Descripción de evidencias inmuebles en el sitio o hallazgo aislado','Potencial estratigráfico','Descripción del potencial estratigráfico','m largo','m ancho','Área m2','Poligono Irregular','Punto 1 Ubicación','Punto 1 Coordenada N','Punto 1 Coordenada E','Punto 2 Ubicación','Punto 2 Coordenada N','Punto 2 Coordenada E','Punto 3 Ubicación','Punto 3 Coordenada N','Punto 3 Coordenada E','Punto 4 Ubicación','Punto 4 Coordenada N','Punto 4 Coordenada E','Punto 5 Ubicación','Punto 5 Coordenada N','Punto 5 Coordenada E','Punto 6 Ubicación','Punto 6 Coordenada N','Punto 6 Coordenada E','Punto 7 Ubicación','Punto 7 Coordenada N','Punto 7 Coordenada E','Asociación con otros hallazgos arqueológicos','Emplazamiento','Descripción general del emplazamiento','Estado de conservación','Descripción estado de conservación','Afectación antrópica','Afectación natural','Registrado por','Fecha','Hora','Registro previo','Observaciones','Status'];
  var rows=fichas.map(function(f){
    var mats=f.mats||{},vtx=f.vertices||[];
    function vp(i,field){return vtx[i]?vtx[i][field]||'':]'';}
    var tipologia=(f.tipologia||[]).join(', ');if(f.tipologiaOtro)tipologia+=(tipologia?', ':'')+f.tipologiaOtro;
    var periodo=(f.periodo||[]).join(', ');
    var empl=(f.emplazamiento||[]).join(', ');if(f.emplOtro)empl+=(empl?', ':'')+f.emplOtro;
    return['',f.proyecto||'',f.codigo||'',f.utmN||'',f.utmE||'',f.huso||'',f.error||'',f.altitud||'',f.region||'',f.provincia||'',f.comuna||'','',f.tipo||'','',tipologia,f.tipologiaOtro||'',periodo,f.periodoEsp||'',mats['Cerámica']&&mats['Cerámica'].qty||'',mats['Lítico']&&mats['Lítico'].qty||'',mats['Malacológico']&&mats['Malacológico'].qty||'',mats['Osteofauna']&&mats['Osteofauna'].qty||'',mats['Metal']&&mats['Metal'].qty||'',mats['Vidrio']&&mats['Vidrio'].qty||'',mats['Porcelana']&&mats['Porcelana'].qty||'',mats['Loza']&&mats['Loza'].qty||'','','',f.diagnosticos||'','','','','','','','','','','','','',f.largo||'',f.ancho||'',f.area||'','',vp(0,'ubicacion'),vp(0,'n'),vp(0,'e'),vp(1,'ubicacion'),vp(1,'n'),vp(1,'e'),vp(2,'ubicacion'),vp(2,'n'),vp(2,'e'),vp(3,'ubicacion'),vp(3,'n'),vp(3,'e'),vp(4,'ubicacion'),vp(4,'n'),vp(4,'e'),vp(5,'ubicacion'),vp(5,'n'),vp(5,'e'),vp(6,'ubicacion'),vp(6,'n'),vp(6,'e'),'',empl,f.emplDesc||'',f.conservacion||'',f.consDesc||'','','',f.responsable||'',f.fecha||'','','',f.obs||'',''];
  });
  var csv=[headers].concat(rows).map(function(row){return row.map(function(cell){var s=String(cell||'').replace(/"/g,'""');return s.includes(',')||s.includes('"')||s.includes('\n')?'"'+s+'"':s;}).join(',');}).join('\n');
  var blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
  var a=document.createElement('a');a.href=URL.createObjectURL(blob);
  var d=new Date();a.download='FichasAyS_'+d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate())+'.csv';
  a.click();URL.revokeObjectURL(a.href);
  showToast('📊 CSV exportado: '+fichas.length+' fichas','success');
}

function showToast(msg,type){var t=document.getElementById('toast');t.textContent=msg;t.className='toast'+(type?' '+type:'');t.classList.add('show');setTimeout(function(){t.classList.remove('show');},type==='success'?3000:2800);}

function exportPDF(){
  var data=getForm();
  var doc=new window.jspdf.jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
  var pw=210,ph=297,ml=14,cw=182;var y=14;
  function sec(t,yy){doc.setFillColor(58,125,44);doc.rect(ml,yy,cw,6,'F');doc.setTextColor(255,255,255);doc.setFont('helvetica','bold');doc.setFontSize(7.5);doc.text(t,ml+2,yy+4.2);return yy+6;}
  function bx(x,yy,w,h,f){if(f)doc.setFillColor(f[0],f[1],f[2]);else doc.setFillColor(255,255,255);doc.setDrawColor(180,180,180);doc.rect(x,yy,w,h,f?'FD':'D');}
  function lbl(t,x,yy){doc.setFont('helvetica','bold');doc.setFontSize(7);doc.setTextColor(80,80,80);doc.text(t,x,yy);}
  function val(t,x,yy,mw){doc.setFont('helvetica','normal');doc.setFontSize(8.5);doc.setTextColor(30,30,30);doc.text(doc.splitTextToSize(t||'',mw||50),x,yy);}
  function chk(label,checked,x,yy){doc.setFillColor(checked?58:255,checked?125:255,checked?44:255);doc.setDrawColor(58,125,44);doc.rect(x,yy-3,3.5,3.5,checked?'F':'D');if(checked){doc.setTextColor(255,255,255);doc.setFontSize(5);doc.text('v',x+0.7,yy-0.2);}doc.setTextColor(30,30,30);doc.setFont('helvetica','normal');doc.setFontSize(7.5);doc.text(label,x+4.5,yy-0.2);}
  function np(n){if(y+n>ph-16){doc.addPage();y=14;}}
  doc.setFillColor(45,106,31);doc.roundedRect(ml,y,22,22,3,3,'F');doc.setFillColor(122,182,72);doc.roundedRect(ml,y+14,22,8,3,3,'F');doc.setFillColor(45,106,31);doc.rect(ml,y+14,22,4,'F');
  doc.setTextColor(255,255,255);doc.setFont('helvetica','bold');doc.setFontSize(13);doc.text('as',ml+4,y+11);doc.setFontSize(5);doc.text('Ambiental',ml+2,y+18);doc.text('y Sectorial',ml+2,y+21.5);
  doc.setTextColor(30,30,30);doc.setFont('helvetica','bold');doc.setFontSize(10.5);doc.text('FICHA DE REGISTRO ARQUEOLÓGICO',ml+26,y+7);
  doc.setFontSize(8);doc.setFont('helvetica','normal');doc.text('PROYECTO '+(data.proyecto||'').toUpperCase(),ml+26,y+13);
  if(data.codigo){doc.setFont('helvetica','bold');doc.setFontSize(10);doc.setTextColor(58,125,44);doc.text(data.codigo,pw-28,y+7);}
  y+=28;
  y=sec('IDENTIFICACIÓN GENERAL',y)+2;
  bx(ml,y,cw,8);lbl('NOMBRE SITIO/HALLAZGO',ml+1,y+3);val(data.sitio,ml+1,y+7,cw-3);y+=8;
  var w3=cw/3;bx(ml,y,w3,7);bx(ml+w3,y,w3,7);bx(ml+w3*2,y,w3,7);
  lbl('REGIÓN',ml+1,y+3);lbl('PROVINCIA',ml+w3+1,y+3);lbl('COMUNA',ml+w3*2+1,y+3);
  val(data.region,ml+1,y+6.5);val(data.provincia,ml+w3+1,y+6.5);val(data.comuna,ml+w3*2+1,y+6.5);y+=10;
  np(30);y=sec('COORDENADAS WGS84',y)+2;
  var gw=cw/4;
  [['UTM NORTE',data.utmN],['UTM ESTE',data.utmE],['HUSO',data.huso],['ALTITUD (msnm)',data.altitud]].forEach(function(p,i){bx(ml+gw*i,y,gw,7);lbl(p[0],ml+gw*i+1,y+3);val(p[1]||'',ml+gw*i+1,y+6.5);});y+=7;
  [['LAT (°)',data.lat],['LON (°)',data.lon],['ERROR GPS (±m)',data.error],['','']].forEach(function(p,i){bx(ml+gw*i,y,gw,7);if(p[0])lbl(p[0],ml+gw*i+1,y+3);val(p[1]||'',ml+gw*i+1,y+6.5);});y+=10;
  np(35);y=sec('CARACTERÍSTICAS GENERALES DEL SITIO/HALLAZGO',y)+2;
  bx(ml,y,cw,7);lbl('TIPO',ml+1,y+3);val(data.tipo,ml+20,y+6.5,cw-22);y+=9;
  lbl('Tipología funcional:',ml,y+3);var tx=ml+35;
  ['Doméstico/habitacional','Productivo','Tránsito','Ritual','Entierro','Indeterminado'].forEach(function(t){chk(t,data.tipologia&&data.tipologia.indexOf(t)>=0,tx,y+3);tx+=30;if(tx>195){tx=ml+35;y+=6;}});
  y+=8;lbl('Período:',ml,y+3);tx=ml+20;
  ['Prehispánico','Histórico','Indeterminado'].forEach(function(p){chk(p,data.periodo&&data.periodo.indexOf(p)>=0,tx,y+3);tx+=30;});
  y+=10;
  np(25);y=sec('DIMENSIONES DE LA UNIDAD',y)+3;
  var dw=cw/3;bx(ml,y,dw,7);bx(ml+dw,y,dw,7);bx(ml+dw*2,y,dw,7);
  lbl('LARGO (m)',ml+1,y+3);lbl('ANCHO (m)',ml+dw+1,y+3);lbl('ÁREA (m²)',ml+dw*2+1,y+3);
  val(data.largo,ml+1,y+6.5);val(data.ancho,ml+dw+1,y+6.5);val(data.area,ml+dw*2+1,y+6.5);y+=10;
  np(20);y=sec('MATERIAL ARQUEOLÓGICO RECOLECTADO',y)+1;
  var c1=40,c2=20,c3=cw-60;
  doc.setFillColor(58,125,44);doc.rect(ml,y,c1,6,'F');doc.rect(ml+c1,y,c2,6,'F');doc.rect(ml+c1+c2,y,c3,6,'F');
  doc.setTextColor(255,255,255);doc.setFont('helvetica','bold');doc.setFontSize(7);doc.text('TIPOLOGÍA',ml+1,y+4.2);doc.text('CANT.',ml+c1+1,y+4.2);doc.text('DESCRIPCIÓN GENERAL',ml+c1+c2+1,y+4.2);y+=6;
  MATS.forEach(function(m,idx){np(7);var fl=idx%2===0?[255,255,255]:[245,250,243];bx(ml,y,c1,6,fl);bx(ml+c1,y,c2,6,fl);bx(ml+c1+c2,y,c3,6,fl);var md=data.mats&&data.mats[m]?data.mats[m]:{qty:'',desc:''};doc.setTextColor(30,30,30);doc.setFont('helvetica',md.qty||md.desc?'bold':'normal');doc.setFontSize(7.5);doc.text(m,ml+1,y+4.2);doc.setFont('helvetica','normal');doc.text(md.qty||'',ml+c1+2,y+4.2);doc.text((doc.splitTextToSize(md.desc||'',c3-2))[0]||'',ml+c1+c2+1,y+4.2);y+=6;});y+=4;
  np(30);y=sec('EMPLAZAMIENTO',y)+3;
  lbl('Emplazamiento:',ml,y+3);tx=ml+30;['Llanura','Lomaje','Ladera','Quebrada','Cerro','Terraza fluvial'].forEach(function(e){chk(e,data.emplazamiento&&data.emplazamiento.indexOf(e)>=0,tx,y+3);tx+=28;});
  y+=9;bx(ml,y,cw,18);lbl('Descripción:',ml+1,y+3);doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(30,30,30);doc.text(doc.splitTextToSize(data.emplDesc||'',cw-4),ml+2,y+8);y+=22;
  np(30);y=sec('ESTADO GENERAL DE CONSERVACIÓN',y)+3;
  chk('Bueno',data.conservacion==='Bueno',ml+18,y+3);chk('Regular',data.conservacion==='Regular',ml+45,y+3);chk('Malo',data.conservacion==='Malo',ml+72,y+3);y+=9;
  bx(ml,y,cw,18);doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(30,30,30);doc.text(doc.splitTextToSize(data.consDesc||'',cw-4),ml+2,y+8);y+=22;
  np(20);y=sec('RESPONSABLES',y)+2;
  bx(ml,y,cw/2,7);bx(ml+cw/2,y,cw/4,7);bx(ml+cw*3/4,y,cw/4,7);
  lbl('RESPONSABLE',ml+1,y+3);lbl('FECHA',ml+cw/2+1,y+3);lbl('CAMPAÑA',ml+cw*3/4+1,y+3);
  val(data.responsable,ml+1,y+6.5,cw/2-3);val(data.fecha,ml+cw/2+1,y+6.5);val(data.campana,ml+cw*3/4+1,y+6.5);y+=7;
  bx(ml,y,cw,7);lbl('AYUDANTES',ml+1,y+3);val(data.ayudantes,ml+1,y+6.5,cw-3);y+=10;
  if(data.obs){np(22);y=sec('OBSERVACIONES',y)+2;bx(ml,y,cw,18);doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(30,30,30);doc.text(doc.splitTextToSize(data.obs,cw-4),ml+2,y+5);y+=22;}
  np(15);y=sec('CROQUIS',y)+4;try{doc.addImage(getCanvasData(),'PNG',ml,y,cw,60,'','MEDIUM');y+=64;}catch(e){y+=4;}
  if(data.photos&&data.photos.length){np(15);y=sec('REGISTRO FOTOGRÁFICO',y)+4;var iw=(cw-4)/2,ih=60;data.photos.forEach(function(p,i){if(i%2===0&&i>0){y+=ih+5;}np(ih+10);var x=ml+(i%2)*(iw+4);try{doc.addImage(p,'JPEG',x,y,iw,ih,'','MEDIUM');}catch(e){}});y+=ih+8;}
  var total=doc.internal.getNumberOfPages();
  for(var pg=1;pg<=total;pg++){doc.setPage(pg);doc.setDrawColor(58,125,44);doc.setLineWidth(0.5);doc.line(ml,ph-12,pw-14,ph-12);doc.setFont('helvetica','normal');doc.setFontSize(7);doc.setTextColor(100,100,100);doc.text('Ambiental y Sectorial  |  Ficha de Registro Arqueológico  |  '+(data.proyecto||''),ml,ph-8);doc.text('Página '+pg+' de '+total,pw-36,ph-8);}
  doc.save('Ficha_'+(data.codigo||'RS')+'_'+(data.sitio||'sin_nombre').replace(/\s+/g,'_')+'_'+data.fecha+'.pdf');
  showToast('📄 PDF exportado','success');
}

init();
if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/Ficha-Arqueologica/sw.js').then(function(r){console.log('SW:',r.scope);}).catch(function(e){console.log('SW error:',e);});});}
